# ── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# ── Assistente LLM — Azure OpenAI (produção) ────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<sua-chave>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
LLM_PROVIDER=azure_openai   # padrão de produção — não alterar em deploy Azure

# ── Alternativa: Anthropic Claude (somente desenvolvimento local) ────────────
# Use apenas quando não houver deployment Azure OpenAI disponível localmente.
# Em produção, esta variável NÃO deve ser definida — o sistema usará Azure OpenAI.
# ANTHROPIC_API_KEY=<sua-chave>
# LLM_PROVIDER=anthropic

# ── API ─────────────────────────────────────────────────────────────────────
MLFLOW_LOG_INTERVAL=100
DECISION_LOG_PATH=logs/decision_log.jsonl

# ── Azure (produção) ─────────────────────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=https://<conta>.documents.azure.com:443/
AZURE_COSMOS_KEY=<sua-chave>
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
